{
  "ConnectionStrings-Template": {
    "DefaultConnection": "Server=.;Database=table;User Id=user;Password=Password;TrustServerCertificate=true;"
  },
  "AllowedHosts-Template": "*",
  "GoogleMaps-Template": {
    "ApiKey":""
  },
  "JwtSettings-Template": {
    "key": "",
    "resetPasswordKey": "",
    "issuer": "http://localhost:5000",
    "audience": "http://localhost:5000",
    "expiresIn-hours": 8,
    "resetPasswordTokenExpiresIn-minutes": 10
  },
  "AutomapperLicenseKey-Template": "",
  "Smtp-Template": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "AppPassword": {
      "User": "",
      "Pass": ""
    }
  },
  "Serilog-Template": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Warning",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "ApplicationName": "ParkeoApp.App"
    }
  }
}
